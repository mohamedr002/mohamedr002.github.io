<div class="lab-pillars row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mt-3">
  {% for pillar in site.data.lab.pillars %}
    <div class="col">
      <div class="card h-100 hoverable">
        <div class="card-body">
          {% if pillar.icon %}
            <div class="pillar-icon mb-2">
              <i class="{{ pillar.icon }} fa-2x"></i>
            </div>
          {% endif %}
          <h3 class="card-title h5">{{ pillar.title }}</h3>
          <p class="card-text">{{ pillar.description }}</p>
        </div>
      </div>
    </div>
  {% endfor %}
</div>
